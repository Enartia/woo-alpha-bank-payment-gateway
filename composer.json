{
    "name": "enartia/woo-alpha-bank-payment-gateway",
    "description": "Development tooling for the Alpha Bank payment gateway for WooCommerce. The plugin itself has no Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "composer/installers": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "*",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress-core-installer": "^1.100 || ^2.0 || ^3.0",
        "roots/wordpress-no-content": "*",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "*",
        "wpackagist-plugin/woocommerce": "*",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Papaki\\AlphaBank\\WooCommerce\\Tests\\": "tests/",
            "Papaki\\AlphaBank\\WooCommerce\\": "classes/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": ".wp-tests/wordpress",
        "installer-paths": {
            ".wp-tests/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "scripts": {
        "lint": "find wooshop-alpha.php classes tests -name \"*.php\" -print0 | xargs -0 -n1 php -l > /dev/null",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test:unit": "phpunit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Checks every PHP file for syntax errors.",
        "phpcs": "Runs the security, correctness and PHP compatibility sniffs.",
        "phpstan": "Runs static analysis at level 5 against the baseline.",
        "test:unit": "Runs the unit tests, without WordPress.",
        "test:integration": "Runs the integration tests, with WordPress and WooCommerce loaded.",
        "test": "Runs the unit and the integration tests.",
        "check": "Runs everything the CI workflow runs."
    }
}
