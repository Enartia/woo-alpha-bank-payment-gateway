#. Description of the plugin
#: wooshop-alpha.php
msgid ""
"Payment Gateway – Nexi Alpha Bank for WooCommerce allows you to accept "
"payment through various channels such as IRIS and Cards like,American "
"Express, Visa, Mastercard, Maestro, Diners Club On your Woocommerce Powered "
"Site."
msgstr ""

#. Author of the plugin
#: wooshop-alpha.php
msgid "Papaki"
msgstr ""

